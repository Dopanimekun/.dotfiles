@import "colors-1.rasi"

* {
 background-color: transparent;
 text-color: @fg2;
 }

 window {
    width: 900px;
    height: 600px;
    background-color: @bg0;
    border: 2px;
    border-color: @fg3;
      border-radius: 12px;
  }

mainbox {
    background-color: @bg3;
    border:  0% 0% 0% 0%;
      border-radius: 0% 0% 0% 0%;
    border-color: @bg3;
  }

inputbar {
    text-color: @fg0;
    padding: 8px;
      background-color: @bg0;
      text-color: @fg3;
      expand: false;
    border: 0% 0% 0% 0%;
      border-radius:  0px;
    border-color: @bg2;
      margin: 0% 0% 0% 0%;
      padding: 1.5%;
  }

entry {
    border: 0% 0% 0% 0%;
    text-color:  #FFFFFF;
    expand: true;
    spacing: 4;
    horizontal-align: 0.5;
    padding: 0.10% 0% 0% 0%;
    placeholder: "Type to search";
    placeholder-color: @fg3;
    blink: true;
  }

listview {
    background-color: @bg0;
    padding: 12px;
    columns:  8;
    lines: 4;
    spacing: 0%;
    cycle: false;
    dynamic: true;
    layout: vertical;
  }

element {
    padding: 6px;
    orientation: vertical;
    border-radius: 0%;
    padding: 2% 0% 2% 0%;
    children: [ element-icon, element-text ];
  }

element-text {
    expand: true;
    vertical-align: 0.5;
    margin: 0.5% 0.5% -0.5% 0.5%;
    text-color: #FFFFFF;
  }

element-icon {
    size: 64px;
    border: 0px;
    vertical-align: 0.5;
  }

element selected {
    background-color: @bg2;
    text-color: @fg2;
    border: 0% 0% 0% 0%;
      border-radius: 12px;
      border-color: @bg0;
  }
