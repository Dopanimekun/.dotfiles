{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "type": "auto",
    "source": "$HOME/.config/fastfetch/logo/*",
    "width": 32,
    "height": null,
    "padding": {
      "top": 1,
      "left": 1,
      "right": 1
    },
  },
  "display": {
    "separator": " :: ",
    "color": {
      "separator": "35"
    },
    "percent": {
      "type": [
        "num",
        "num-color",
      ],
      "ndigits": 0,
      "color": {
        "green": "32",
        "yellow": "93",
        "red": "91"
      },
      "spaceBeforeUnit": "default",
      "width": 0
    },
    "bar": {
      "char": {
        "elapsed": "●",
        "total": "○"
      },
      "border": {
        "left": "[",
        "right": "]",
        "leftElapsed": "",
        "rightElapsed": ""
      },
      "color": {
        "elapsed": "34",
        "total": "33",
        "border": "32"
      },
      "width": 10
    },
    "key": {
      "width": 0,
      "type": "both-1",
      "paddingLeft": 0
    },
  },
  "general": {
    "thread": true,
    "processingTimeout": 5000,
    "detectVersion": true,
    "playerName": "",
    "dsForceDrm": false
  },
  "modules": [
    "break",
    /*{
      "type": "title",
      "key": " ",
      "keyIcon": "",
      "fqdn": false,
      "color": {
        "user": "",
        "at": "",
        "host": ""
      }
    },*/
    {
      "type": "custom",
      "format": "\u001b[38;5;159m╭─────────────────────── Setup ───────────────────────╮\u001b[0m"
    },
    {
      "type": "host",
      "key": "\u001b[33mBoard\u001b[0m",
      "keyIcon": "\u001b[38;5;159m├ 󰌢\u001b[0m"
    },
    {
      "type": "os",
      "key": "\u001b[33mSystem\u001b[0m",
      "keyIcon": "\u001b[38;5;159m├ \u001b[0m"
    },
    {
      "type": "kernel",
      "key": "\u001b[33mKernel\u001b[0m",
      "keyIcon": "\u001b[38;5;159m├ \u001b[0m"
    },
        {
      "type": "cpu",
      "key": "\u001b[33mCPU\u001b[0m",
      "keyIcon": "\u001b[38;5;159m├ \u001b[0m",
      "temp": false,
      "showPeCoreCount": false
    },
    {
      "type": "gpu",
      "key": "\u001b[33mGPU\u001b[0m",
      "keyIcon": "\u001b[38;5;159m├ 󰾲\u001b[0m",
      "driverSpecific": false,
      "detectionMethod": "pci",
      "temp": false,
      "hideType": "none",
      "percent": {
        "green": 50,
        "yellow": 80,
        "type": 0
      }
    },
    {
      "type": "packages",
      "key": "\u001b[33mPackages\u001b[0m",
      "keyIcon": "\u001b[38;5;159m├ 󰏖\u001b[0m",
      "disabled": [
        "apk"
      ],
      "combined": false
    },
    {
      "type": "custom",
      "format": "\u001b[38;5;159m├────────────────────── Terminal ─────────────────────┤\u001b[0m"
    },
    {
      "type": "shell",
      "key": "\u001b[32mShell\u001b[0m",
      "keyIcon": "\u001b[38;5;159m├ \u001b[0m"
    },
    {
      "type": "de",
      "key": "\u001b[32mDE\u001b[0m",
      "keyIcon": "\u001b[38;5;159m├ \u001b[0m",
      "slowVersionDetection": false
    },
    {
      "type": "wm",
      "key": "\u001b[32mWM\u001b[0m",
      "keyIcon": "\u001b[38;5;159m├ \u001b[0m",
      "detectPlugin": false
    },
    {
      "type": "font",
      "key": "\u001b[32mSystem Font\u001b[0m",
      "keyIcon": "\u001b[38;5;159m├ \u001b[0m"
    },
    {
      "type": "terminal",
      "key": "\u001b[32mTerminal\u001b[0m",
      "keyIcon": "\u001b[38;5;159m├ \u001b[0m"
    },
    {
      "type": "terminalfont",
      "key": "\u001b[32mTerminal Font\u001b[0m",
      "keyIcon": "\u001b[38;5;159m├ \u001b[0m"
    },
    {
      "type": "custom",
      "format": "\u001b[38;5;159m├─────────────────────── Memory ──────────────────────┤\u001b[0m"
    },
    {
      "type": "memory",
      "key": "\u001b[94mRAM\u001b[0m",
      "keyIcon": "\u001b[38;5;159m├ \u001b[0m",
      "percent": {
        "green": 50,
        "yellow": 80,
        "type": 0
      }
    },
    {
      "type": "swap",
      "key": "\u001b[94mSwap\u001b[0m",
      "percent": {
        "green": 50,
        "yellow": 80,
        "type": 0
      },
      "keyIcon": "\u001b[38;5;159m├ 󰓡\u001b[0m",
      "separate": false
    },
    {
      "type": "disk",
      "key": "\u001b[94mPartition\u001b[0m",
      "keyIcon": "\u001b[38;5;159m├ \u001b[0m",
      "showRegular": true,
      "showReadOnly": false,
      "percent": {
        "green": 50,
        "yellow": 80,
        "type": 0
      }
    },
    {
      "type": "custom",
      "format": "\u001b[38;5;159m╰─────────────────────────────────────────────────────╯\u001b[0m"
    },

    "break",
    {
      "type": "colors",
      "key": " ",
      "keyIcon": "",
      "symbol": "circle",
      "paddingLeft": 1,
      "block": {
        "width": 3,
        "range": [
          0,
          15
        ]
      }
    }
  ]
}
